<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Jellyfin.Plugin.ThunderSubtitle.Tests</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ThunderSubtitle.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Plugin.ThunderSubtitle\Jellyfin.Plugin.ThunderSubtitle.csproj" />
    <!--
      The plugin project deliberately does not copy Jellyfin assemblies next to its dll.
      The test host needs them at runtime to construct PluginConfiguration, so they are
      referenced here with their runtime assets included.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
  </ItemGroup>

</Project>
